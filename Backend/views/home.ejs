<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link  rel="stylesheet" href="\css\home.css" >
    <title>Instagram</title>
</head>
<body>
 <h1> Instagram</h1>
 <hr>
 <form action="/post" method="get">
  <button type="submit">Create</button>
 </form>
 <div>
    <%for( let  post of users){%>
        <div>@<%=post.username  %> </div>
        <!-- <img src="<%=post.image %>" alt="photo"> -->
        <!-- <div><i><%=post.caption %></i></div> -->
         <div> <%=post.email  %> </div>
        <form method="post" action="/<%=post.id%>/delete?_method=DELETE">
          <button  name="delete" type="submit">Delete</button>
        </form>
        <form method="get" action="/<%=post.id%>/edit">
          <button  name="edit" type="submit">Edit</button>
        </form>
        <br>
      <% }
    %>
    
 </div>
</body>
</html>